# Copy this file to .env and fill in your values

# Server
PORT=3000

# Auth — leave blank to disable bearer-token checking
API_KEY=change-me-to-something-secret

# Database client: "pg" for PostgreSQL, "mysql2" for MySQL/MariaDB
DB_CLIENT=pg

DB_HOST=localhost
DB_PORT=5432        # 5432 for Postgres, 3306 for MySQL
DB_USER=foundry
DB_PASSWORD=secret
DB_NAME=foundry_stats
